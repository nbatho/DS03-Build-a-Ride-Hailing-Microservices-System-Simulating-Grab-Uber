{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "src/apps/api-gateway",
  "sourceRoot": "src/apps/api-gateway/src",
  "compilerOptions": {
    "webpack": true,
    "deleteOutDir": true,
    "tsConfigPath": "src/apps/api-gateway/tsconfig.app.json"
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "src/apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "src/apps/api-gateway/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/apps/api-gateway/tsconfig.app.json"
      }
    },
    "identity-user-service": {
      "type": "application",
      "root": "src/services/identity-user-service",
      "entryFile": "main",
      "sourceRoot": "src/services/identity-user-service/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/services/identity-user-service/tsconfig.app.json"
      }
    },
    "driver-vehicle-location-service": {
      "type": "application",
      "root": "src/services/driver-vehicle-location-service",
      "entryFile": "main",
      "sourceRoot": "src/services/driver-vehicle-location-service/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/services/driver-vehicle-location-service/tsconfig.app.json"
      }
    },
    "trip-booking-service": {
      "type": "application",
      "root": "src/services/trip-booking-service",
      "entryFile": "main",
      "sourceRoot": "src/services/trip-booking-service/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/services/trip-booking-service/tsconfig.app.json"
      }
    },
    "simulated-payment-service": {
      "type": "application",
      "root": "src/services/simulated-payment-service",
      "entryFile": "main",
      "sourceRoot": "src/services/simulated-payment-service/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/services/simulated-payment-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "src/services/notification-service",
      "entryFile": "main",
      "sourceRoot": "src/services/notification-service/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/services/notification-service/tsconfig.app.json"
      }
    },
    "matching-service": {
      "type": "application",
      "root": "src/services/matching-service",
      "entryFile": "main",
      "sourceRoot": "src/services/matching-service/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/services/matching-service/tsconfig.app.json"
      }
    },
    "pricing-service": {
      "type": "application",
      "root": "src/services/pricing-service",
      "entryFile": "main",
      "sourceRoot": "src/services/pricing-service/src",
      "compilerOptions": {
        "webpack": true,
        "deleteOutDir": true,
        "tsConfigPath": "src/services/pricing-service/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "src/packages/contracts",
      "entryFile": "index",
      "sourceRoot": "src/packages/contracts/src",
      "compilerOptions": {
        "webpack": false,
        "deleteOutDir": true,
        "tsConfigPath": "src/packages/contracts/tsconfig.lib.json"
      }
    },
    "shared-types": {
      "type": "library",
      "root": "src/packages/shared-types",
      "entryFile": "index",
      "sourceRoot": "src/packages/shared-types/src",
      "compilerOptions": {
        "webpack": false,
        "deleteOutDir": true,
        "tsConfigPath": "src/packages/shared-types/tsconfig.lib.json"
      }
    },
    "runtime": {
      "type": "library",
      "root": "src/packages/runtime",
      "entryFile": "index",
      "sourceRoot": "src/packages/runtime/src",
      "compilerOptions": {
        "webpack": false,
        "deleteOutDir": true,
        "tsConfigPath": "src/packages/runtime/tsconfig.lib.json"
      }
    }
  }
}
