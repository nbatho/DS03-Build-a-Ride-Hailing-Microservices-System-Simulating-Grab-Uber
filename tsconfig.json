{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@app/contracts": [
        "src/packages/contracts/src"
      ],
      "@app/contracts/*": [
        "src/packages/contracts/src/*"
      ],
      "@app/shared-types": [
        "src/packages/shared-types/src"
      ],
      "@app/shared-types/*": [
        "src/packages/shared-types/src/*"
      ],
      "@app/runtime": [
        "src/packages/runtime/src"
      ],
      "@app/runtime/*": [
        "src/packages/runtime/src/*"
      ],
      "@app/auth": [
        "src/packages/auth/src"
      ],
      "@app/auth/*": [
        "src/packages/auth/src/*"
      ],
      "@app/messaging": [
        "src/packages/messaging/src"
      ],
      "@app/messaging/*": [
        "src/packages/messaging/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.spec.ts"
  ]
}
