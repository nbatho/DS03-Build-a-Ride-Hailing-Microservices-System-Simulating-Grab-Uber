# NestJS HTTP apps read this file via @nestjs/config after copying it to .env.
# Local default; set HOST=0.0.0.0 when running inside containers.
HOST=127.0.0.1

# API Gateway - BA section 3.1
GATEWAY_PORT=8080

# identity-user-service
IDENTITY_PORT=3001

# driver-vehicle-location-service
DRIVER_PORT=3002

# trip-booking-service
TRIP_PORT=3003

# simulated-payment-service
PAYMENT_PORT=3004

# notification-service
NOTIFICATION_PORT=3005

# matching-service
MATCHING_PORT=3006

# pricing-service
PRICING_PORT=3007

# Identity dev setup: npm run identity:setup:dev (does not overwrite .env)
IDENTITY_BASE_URL=http://127.0.0.1:3001
IDENTITY_DB_SCHEMA=identity_schema
IDENTITY_BOOTSTRAP_PASSWORD=<local-only>
IDENTITY_APP_PASSWORD=<local-only>
IDENTITY_MIGRATOR_PASSWORD=<local-only>
IDENTITY_DATABASE_URL=postgresql://identity_app:<local-only>@127.0.0.1:5541/ride_hailing
IDENTITY_MIGRATION_DATABASE_URL=postgresql://identity_migrator:<local-only>@127.0.0.1:5541/ride_hailing
JWT_ISSUER=ride-hailing
JWT_AUDIENCE=ride-api
JWT_ACCESS_TTL_SECONDS=3600
JWT_PUBLIC_KEY_FILE=deploy/secrets/identity-public.pem
JWT_PRIVATE_KEY_FILE=deploy/secrets/identity-private.pem
BCRYPT_ROUNDS=10
# Empty by default. For Gateway deployment allowlist only its proxy address/CIDR.
IDENTITY_TRUSTED_PROXY_CIDRS=

# B: mỗi service một PostgreSQL riêng (deploy/b-dev.compose.yml).
# npm run b:setup:dev tự ghi khối này vào .env với mật khẩu ngẫu nhiên.
# driver-vehicle-location-service -> driver-db :5542
DRIVER_DB_SCHEMA=driver_schema
DRIVER_BOOTSTRAP_PASSWORD=<local-only>
DRIVER_APP_PASSWORD=<local-only>
DRIVER_MIGRATOR_PASSWORD=<local-only>
DRIVER_DATABASE_URL=postgresql://driver_app:<local-only>@127.0.0.1:5542/driver_db
DRIVER_MIGRATION_DATABASE_URL=postgresql://driver_migrator:<local-only>@127.0.0.1:5542/driver_db

# matching-service -> matching-db :5546
MATCHING_DB_SCHEMA=matching_schema
MATCHING_BOOTSTRAP_PASSWORD=<local-only>
MATCHING_APP_PASSWORD=<local-only>
MATCHING_MIGRATOR_PASSWORD=<local-only>
MATCHING_DATABASE_URL=postgresql://matching_app:<local-only>@127.0.0.1:5546/matching_db
MATCHING_MIGRATION_DATABASE_URL=postgresql://matching_migrator:<local-only>@127.0.0.1:5546/matching_db

# pricing-service -> pricing-db :5547
PRICING_DB_SCHEMA=pricing_schema
PRICING_BOOTSTRAP_PASSWORD=<local-only>
PRICING_APP_PASSWORD=<local-only>
PRICING_MIGRATOR_PASSWORD=<local-only>
PRICING_DATABASE_URL=postgresql://pricing_app:<local-only>@127.0.0.1:5547/pricing_db
PRICING_MIGRATION_DATABASE_URL=postgresql://pricing_migrator:<local-only>@127.0.0.1:5547/pricing_db
