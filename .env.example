# NestJS HTTP apps read this file via @nestjs/config after copying it to .env.
# Local default; set HOST=0.0.0.0 when running inside containers.
HOST=127.0.0.1

# API Gateway - BA section 3.1
GATEWAY_PORT=8080

# identity-user-service
IDENTITY_PORT=3001

# driver-vehicle-location-service
DRIVER_PORT=3002

# trip-booking-service
TRIP_PORT=3003

# simulated-payment-service
PAYMENT_PORT=3004

# notification-service
NOTIFICATION_PORT=3005

# matching-service
MATCHING_PORT=3006

# pricing-service
PRICING_PORT=3007

# Reserved for future infrastructure integration; startup does not connect yet.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ride_hailing
POSTGRES_ADMIN_PASSWORD=replace_me
IDENTITY_DB_PASSWORD=replace_me
DRIVER_DB_PASSWORD=replace_me
MATCHING_DB_PASSWORD=replace_me
TRIP_DB_PASSWORD=replace_me
PRICING_DB_PASSWORD=replace_me
PAYMENT_DB_PASSWORD=replace_me
NOTIFICATION_DB_PASSWORD=replace_me
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=replace_me
RABBITMQ_PASSWORD=replace_me
RABBITMQ_VHOST=ride
