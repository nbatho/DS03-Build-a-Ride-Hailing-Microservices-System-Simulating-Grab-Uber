        "causation_id": {
          "type": "string",
          "description": "Mã request/command/event gây ra thay đổi.",
          "example": "541af9b9-e8c6-5cec-800d-abeabc2cccd3",
          "format": "uuid"
        },
        "producer": {
          "type": "string",
          "enum": ["trip-booking-service"],
          "description": "",
          "example": "trip-booking-service"
        },
        "payload": {
          "$ref": "#/$defs/Evt_trip_requested"
        }
