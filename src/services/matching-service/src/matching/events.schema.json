{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matching event contracts extracted from the BA catalog",
  "$defs": {
    "Evt_trip_requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tripId": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
          "example": "a1031bdc-44d7-5c67-93ff-7f11b2987aa4",
          "format": "uuid"
        },
        "passengerId": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
          "example": "c15878c4-5fc0-5082-a243-691c58a8c3f3",
          "format": "uuid"
        },
        "pickup": {
          "$ref": "#/$defs/Point"
        },
        "dropoff": {
          "$ref": "#/$defs/Point"
        },
        "amount": {
          "type": "string",
          "description": "Số nguyên VND dạng chuỗi; không dùng float JSON để cộng tiền.",
          "example": "41000",
          "pattern": "^\\d{1,14}$"
        },
        "currency": {
          "type": "string",
          "enum": ["VND"],
          "description": "",
          "example": "VND"
        },
        "tripVersion": {
          "type": "integer",
          "description": "Version tăng khi aggregate thay đổi; kiểm tra bằng compare-and-set.",
          "example": 1,
          "minimum": 1
        }
      },
      "required": [
        "tripId",
        "passengerId",
        "pickup",
        "dropoff",
        "amount",
        "currency",
        "tripVersion"
      ],
      "description": ""
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "example": 10.77
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "example": 106.69
        },
        "zoneId": {
          "type": "string",
          "enum": ["ZONE_A", "ZONE_B"],
          "description": "Vùng mô phỏng; Matching lọc theo zoneId, không dùng định tuyến bản đồ thật.",
          "example": "ZONE_A"
        }
      },
      "required": ["lat", "lng", "zoneId"],
      "description": ""
    },
    "Evt_matching_offer_created": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offer": {
          "$ref": "#/$defs/Offer"
        },
        "pickup": {
          "$ref": "#/$defs/Point"
        },
        "dropoff": {
          "$ref": "#/$defs/Point"
        },
        "amount": {
          "type": "string",
          "description": "Số nguyên VND dạng chuỗi; không dùng float JSON để cộng tiền.",
          "example": "41000",
          "pattern": "^\\d{1,14}$"
        },
        "currency": {
          "type": "string",
          "enum": ["VND"],
          "description": "",
          "example": "VND"
        }
      },
      "required": ["offer", "pickup", "dropoff", "amount", "currency"],
      "description": ""
    },
    "Offer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
          "example": "98ab7112-564a-52de-8def-1c2c92fca864",
          "format": "uuid"
        },
        "jobId": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
          "example": "69cbecf7-1a8d-5259-8666-62228770e284",
          "format": "uuid"
        },
        "tripId": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
          "example": "a1031bdc-44d7-5c67-93ff-7f11b2987aa4",
          "format": "uuid"
        },
        "driverId": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
          "example": "e7c02766-ce0d-553f-b18a-3860ac1be699",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "CLAIMED", "ACCEPTED", "REJECTED", "EXPIRED", "CANCELLED"],
          "description": "",
          "example": "OPEN"
        },
        "expiresAt": {
          "type": "string",
          "description": "UTC, RFC 3339; đồng hồ ví dụ, không phải thời hạn còn hiệu lực.",
          "example": "2026-10-11T02:00:15Z",
          "format": "date-time"
        },
        "assignmentId": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
          "example": "40f54b0d-49ab-50a9-a794-7e42581d2be7",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "description": "Version tăng khi aggregate thay đổi; kiểm tra bằng compare-and-set.",
          "example": 1,
          "minimum": 1
        }
      },
      "required": ["id", "jobId", "tripId", "driverId", "status", "expiresAt", "version"],
      "description": ""
    },
    "Evt_matching_failed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tripId": {
          "type": "string",
          "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
