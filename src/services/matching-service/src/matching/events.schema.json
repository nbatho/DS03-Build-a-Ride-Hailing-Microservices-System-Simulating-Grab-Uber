        "jobVersion": {
          "type": "integer",
          "description": "Version tăng khi aggregate thay đổi; kiểm tra bằng compare-and-set.",
          "example": 1,
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "enum": ["NO_CANDIDATE", "SEARCH_TIMEOUT"],
          "description": "",
          "example": "NO_CANDIDATE"
        }
      },
      "required": ["tripId", "jobId", "jobVersion", "reason"],
      "description": ""
    },
    "Evt_trip_cancelled": {
      "type": "object",
      "additionalProperties": false,
