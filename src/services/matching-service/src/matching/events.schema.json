          "example": "c15878c4-5fc0-5082-a243-691c58a8c3f3",
          "format": "uuid"
        },
        "affectedDriverIds": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "UUID chuẩn, không dùng số tự tăng để liên kết service.",
            "example": "e7c02766-ce0d-553f-b18a-3860ac1be699",
            "format": "uuid"
          },
          "maxItems": 100
        },
        "tripVersion": {
          "type": "integer",
          "description": "Version tăng khi aggregate thay đổi; kiểm tra bằng compare-and-set.",
          "example": 1,
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "enum": ["CHANGE_PLAN", "WAIT_TOO_LONG"],
          "description": "",
          "example": "CHANGE_PLAN"
        }
      },
      "required": ["tripId", "passengerId", "affectedDriverIds", "tripVersion", "reason"],
      "description": ""
    }
