{
  "name": "ds03-ride-hailing",
  "version": "0.1.0",
  "private": true,
  "description": "Ride-hailing microservices system simulating Grab/Uber",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:api-gateway",
    "start": "npm run start:api-gateway",
    "start:dev": "npm run dev:api-gateway",
    "start:prod": "npm run prod:api-gateway",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/identity-user-service/tests/unit/auth.test.cjs src/packages/runtime/tests/internal-auth.test.cjs src/packages/messaging/tests/messaging.test.cjs src/services/pricing-service/tests/unit/fare-calculator.test.cjs src/services/driver-vehicle-location-service/tests/unit/driver-status.test.cjs src/services/matching-service/tests/unit/contracts.test.cjs src/services/trip-booking-service/tests/unit/trip-contracts.test.cjs src/services/trip-booking-service/tests/unit/saga-rules.test.cjs src/services/trip-booking-service/tests/unit/trip-payments.test.cjs src/services/simulated-payment-service/tests/unit/payment-rules.test.cjs src/services/notification-service/tests/unit/notification-rules.test.cjs",
    "test:integration": "npm run build:all && npm run build:identity-migrations && node --test tests/startup.test.cjs tests/identity.integration.test.cjs src/services/pricing-service/tests/integration/pricing.test.cjs src/services/driver-vehicle-location-service/tests/integration/driver.test.cjs src/services/matching-service/tests/integration/matching.test.cjs src/services/trip-booking-service/tests/integration/trip-db.test.cjs src/services/trip-booking-service/tests/integration/trips.test.cjs src/services/trip-booking-service/tests/integration/saga.test.cjs src/services/trip-booking-service/tests/integration/trip-complete.test.cjs && npm run test:c:integration",
    "test:c:integration": "npm run test:gateway && npm run test:messaging:integration && npm run test:payment:integration && npm run test:notification:integration && npm run test:c:recovery && npm run test:c:security",
    "test:stack": "npm run test:e2e && npm run test:contract && npm run test:trip:security && npm run test:trip:concurrency && npm run test:trip:recovery",
    "test:all": "npm test && npm run test:stack",
    "test:p01": "node --test --test-timeout=3600000 tests/performance/p01-load.test.cjs",
    "demo": "node scripts/demo/run-demo.cjs",
    "test:smoke": "node --test tests/startup.test.cjs",
    "build:all": "node scripts/build-all.cjs",
    "start:all": "concurrently --kill-others --names api-gateway,identity-user-service,driver-vehicle-location-service,trip-booking-service,simulated-payment-service,notification-service,matching-service,pricing-service \"npm:start:api-gateway\" \"npm:start:identity-user-service\" \"npm:start:driver-vehicle-location-service\" \"npm:start:trip-booking-service\" \"npm:start:simulated-payment-service\" \"npm:start:notification-service\" \"npm:start:matching-service\" \"npm:start:pricing-service\"",
    "start:dev:all": "concurrently --kill-others --names api-gateway,identity-user-service,driver-vehicle-location-service,trip-booking-service,simulated-payment-service,notification-service,matching-service,pricing-service \"npm:dev:api-gateway\" \"npm:dev:identity-user-service\" \"npm:dev:driver-vehicle-location-service\" \"npm:dev:trip-booking-service\" \"npm:dev:simulated-payment-service\" \"npm:dev:notification-service\" \"npm:dev:matching-service\" \"npm:dev:pricing-service\"",
    "start:prod:all": "concurrently --kill-others --names api-gateway,identity-user-service,driver-vehicle-location-service,trip-booking-service,simulated-payment-service,notification-service,matching-service,pricing-service \"npm:prod:api-gateway\" \"npm:prod:identity-user-service\" \"npm:prod:driver-vehicle-location-service\" \"npm:prod:trip-booking-service\" \"npm:prod:simulated-payment-service\" \"npm:prod:notification-service\" \"npm:prod:matching-service\" \"npm:prod:pricing-service\"",
    "build:api-gateway": "nest build api-gateway",
    "start:api-gateway": "nest start api-gateway",
    "dev:api-gateway": "nest start api-gateway --watch",
    "prod:api-gateway": "node dist/api-gateway/main.js",
    "build:identity-user-service": "nest build identity-user-service",
    "start:identity-user-service": "nest start identity-user-service",
    "dev:identity-user-service": "nest start identity-user-service --watch",
    "prod:identity-user-service": "node dist/identity-user-service/main.js",
    "build:driver-vehicle-location-service": "nest build driver-vehicle-location-service",
    "start:driver-vehicle-location-service": "nest start driver-vehicle-location-service",
    "dev:driver-vehicle-location-service": "nest start driver-vehicle-location-service --watch",
    "prod:driver-vehicle-location-service": "node dist/driver-vehicle-location-service/main.js",
    "build:trip-booking-service": "nest build trip-booking-service",
    "start:trip-booking-service": "nest start trip-booking-service",
    "dev:trip-booking-service": "nest start trip-booking-service --watch",
    "prod:trip-booking-service": "node dist/trip-booking-service/main.js",
    "build:simulated-payment-service": "nest build simulated-payment-service",
    "start:simulated-payment-service": "nest start simulated-payment-service",
    "dev:simulated-payment-service": "nest start simulated-payment-service --watch",
    "prod:simulated-payment-service": "node dist/simulated-payment-service/main.js",
    "build:notification-service": "nest build notification-service",
    "start:notification-service": "nest start notification-service",
    "dev:notification-service": "nest start notification-service --watch",
    "prod:notification-service": "node dist/notification-service/main.js",
    "build:matching-service": "nest build matching-service",
    "start:matching-service": "nest start matching-service",
    "dev:matching-service": "nest start matching-service --watch",
    "prod:matching-service": "node dist/matching-service/main.js",
    "build:pricing-service": "nest build pricing-service",
    "start:pricing-service": "nest start pricing-service",
    "dev:pricing-service": "nest start pricing-service --watch",
    "prod:pricing-service": "node dist/pricing-service/main.js",
    "identity:setup:dev": "node scripts/identity/setup-dev.cjs",
    "auth:keys:generate": "node scripts/identity/generate-keys.cjs",
    "svc:tokens": "node scripts/dev/service-tokens.cjs",
    "identity:db:up": "node scripts/identity/dev-db.cjs up",
    "identity:db:stop": "node scripts/identity/dev-db.cjs stop",
    "identity:db:start": "node scripts/identity/dev-db.cjs start",
    "migration:identity:run": "node scripts/identity/migrate.cjs run",
    "migration:identity:show": "node scripts/identity/migrate.cjs show",
    "migration:identity:revert": "node scripts/identity/migrate.cjs revert",
    "build:identity-migrations": "tsc -p src/services/identity-user-service/tsconfig.migrations.json",
    "test:identity:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/identity-user-service/tests/unit/auth.test.cjs",
    "test:runtime:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/packages/runtime/tests/internal-auth.test.cjs",
    "test:runtime:db": "node --test -r ts-node/register -r tsconfig-paths/register src/packages/runtime/tests/idempotency.test.cjs",
    "test:pricing:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/pricing-service/tests/unit/fare-calculator.test.cjs",
    "test:pricing:integration": "npm run build:pricing-service && node --test src/services/pricing-service/tests/integration/pricing.test.cjs",
    "test:driver:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/driver-vehicle-location-service/tests/unit/driver-status.test.cjs",
    "test:matching:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/matching-service/tests/unit/contracts.test.cjs",
    "test:matching:integration": "npm run build:matching-service && node --test src/services/matching-service/tests/integration/matching.test.cjs",
    "test:driver:integration": "npm run build:identity-user-service && npm run build:identity-migrations && npm run build:driver-vehicle-location-service && node --test src/services/driver-vehicle-location-service/tests/integration/driver.test.cjs",
    "test:messaging:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/packages/messaging/tests/messaging.test.cjs",
    "test:messaging:integration": "node --test -r ts-node/register -r tsconfig-paths/register tests/messaging.integration.test.cjs",
    "test:payment:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/simulated-payment-service/tests/unit/payment-rules.test.cjs",
    "test:payment:integration": "node --test -r ts-node/register -r tsconfig-paths/register src/services/simulated-payment-service/tests/integration/payment-db.test.cjs",
    "test:notification:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/notification-service/tests/unit/notification-rules.test.cjs",
    "test:notification:integration": "node --test -r ts-node/register -r tsconfig-paths/register src/services/notification-service/tests/integration/notification-db.test.cjs",
    "test:trip:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/trip-booking-service/tests/unit/trip-contracts.test.cjs src/services/trip-booking-service/tests/unit/saga-rules.test.cjs src/services/trip-booking-service/tests/unit/trip-payments.test.cjs",
    "test:trip:integration": "npm run build:trip-booking-service && npm run build:pricing-service && npm run build:simulated-payment-service && npm run build:notification-service && node --test src/services/trip-booking-service/tests/integration/trip-db.test.cjs src/services/trip-booking-service/tests/integration/trips.test.cjs src/services/trip-booking-service/tests/integration/saga.test.cjs src/services/trip-booking-service/tests/integration/trip-complete.test.cjs",
    "test:e2e": "node --test --test-concurrency=1 tests/end-to-end/happy-path.test.cjs tests/end-to-end/trip-create-from-quote.test.cjs",
    "test:trip:concurrency": "node --test --test-concurrency=1 tests/concurrency/concurrency-driver-double-booking.test.cjs tests/concurrency/concurrency-start-vs-cancel-trip.test.cjs",
    "test:trip:recovery": "npm run build:identity-user-service && npm run build:identity-migrations && npm run build:driver-vehicle-location-service && npm run build:trip-booking-service && node --test --test-concurrency=1 tests/fault-tolerance/resilience-payment-service-down.test.cjs tests/fault-tolerance/resilience-accept-saga-lost-reply-and-crash.test.cjs tests/fault-tolerance/resilience-payment-result-reconciliation.test.cjs",
    "test:trip:security": "node --test tests/security/security-trip-access-control.test.cjs",
    "test:contract": "node --test -r ts-node/register -r tsconfig-paths/register tests/contract/contract-identity-and-trip-api.test.cjs",
    "ops:retry": "node scripts/ops/retry-operation.cjs",
    "test:gateway": "npm run build:api-gateway && node --test src/apps/api-gateway/tests/integration/gateway.test.cjs",
    "test:c:unit": "npm run test:messaging:unit && npm run test:payment:unit && npm run test:notification:unit && npm run test:gateway",
    "test:identity:integration": "npm run build:all && npm run build:identity-migrations && node --test tests/identity.integration.test.cjs",
    "test:identity:security": "npm run test:identity:integration",
    "demo:identity": "node scripts/identity/demo.cjs",
    "demo:driver": "node scripts/simulation/driver-gps.cjs --once",
    "simulate:driver": "node scripts/simulation/driver-gps.cjs",
    "identity:dev": "concurrently --kill-others --names gateway,identity,driver \"npm:dev:api-gateway\" \"npm:dev:identity-user-service\" \"npm:dev:driver-vehicle-location-service\"",
    "b:setup:dev": "node scripts/b/setup-dev.cjs",
    "matching:setup:dev": "node scripts/matching/setup-dev.cjs",
    "matching:mq:up": "docker compose --env-file .env -f deploy/matching-dev.compose.yml up -d --wait",
    "matching:mq:stop": "docker compose --env-file .env -f deploy/matching-dev.compose.yml stop",
    "matching:emit": "node -r ts-node/register -r tsconfig-paths/register scripts/fakes/publish-trip-event.cjs",
    "matching:fake-trip": "node scripts/fakes/trip.cjs",
    "b:db:up": "docker compose --env-file .env -f deploy/b-dev.compose.yml up -d --wait",
    "b:db:stop": "docker compose --env-file .env -f deploy/b-dev.compose.yml stop",
    "b:db:start": "docker compose --env-file .env -f deploy/b-dev.compose.yml start",
    "b:db:status": "docker compose --env-file .env -f deploy/b-dev.compose.yml ps",
    "b:db:verify": "node scripts/b/verify-db.cjs",
    "migration:b:run": "npm run migration:driver:run && npm run migration:matching:run && npm run migration:pricing:run",
    "migration:driver:run": "node -r ts-node/register node_modules/typeorm/cli.js migration:run -d src/services/driver-vehicle-location-service/src/database/data-source.ts",
    "migration:driver:revert": "node -r ts-node/register node_modules/typeorm/cli.js migration:revert -d src/services/driver-vehicle-location-service/src/database/data-source.ts",
    "migration:matching:run": "node -r ts-node/register node_modules/typeorm/cli.js migration:run -d src/services/matching-service/src/database/data-source.ts",
    "migration:matching:revert": "node -r ts-node/register node_modules/typeorm/cli.js migration:revert -d src/services/matching-service/src/database/data-source.ts",
    "migration:pricing:run": "node -r ts-node/register node_modules/typeorm/cli.js migration:run -d src/services/pricing-service/src/database/data-source.ts",
    "migration:pricing:revert": "node -r ts-node/register node_modules/typeorm/cli.js migration:revert -d src/services/pricing-service/src/database/data-source.ts",
    "trip:setup:dev": "node scripts/trip/setup-dev.cjs",
    "trip:db:up": "docker compose --env-file .env -f deploy/trip-dev.compose.yml up -d --wait",
    "trip:db:stop": "docker compose --env-file .env -f deploy/trip-dev.compose.yml stop",
    "trip:db:start": "docker compose --env-file .env -f deploy/trip-dev.compose.yml start",
    "trip:db:status": "docker compose --env-file .env -f deploy/trip-dev.compose.yml ps",
    "migration:trip:run": "node -r ts-node/register node_modules/typeorm/cli.js migration:run -d src/services/trip-booking-service/src/database/data-source.ts",
    "migration:trip:revert": "node -r ts-node/register node_modules/typeorm/cli.js migration:revert -d src/services/trip-booking-service/src/database/data-source.ts",
    "c:setup:dev": "node scripts/c/setup-dev.cjs",
    "c:db:up": "docker compose --env-file .env -f deploy/c-dev.compose.yml up -d --wait",
    "c:db:stop": "docker compose --env-file .env -f deploy/c-dev.compose.yml stop",
    "c:db:start": "docker compose --env-file .env -f deploy/c-dev.compose.yml start",
    "c:db:status": "docker compose --env-file .env -f deploy/c-dev.compose.yml ps",
    "c:db:verify": "node scripts/c/verify-db.cjs",
    "migration:c:run": "npm run migration:payment:run && npm run migration:notification:run",
    "migration:payment:run": "node -r ts-node/register node_modules/typeorm/cli.js migration:run -d src/services/simulated-payment-service/src/database/data-source.ts",
    "migration:payment:revert": "node -r ts-node/register node_modules/typeorm/cli.js migration:revert -d src/services/simulated-payment-service/src/database/data-source.ts",
    "migration:notification:run": "node -r ts-node/register node_modules/typeorm/cli.js migration:run -d src/services/notification-service/src/database/data-source.ts",
    "migration:notification:revert": "node -r ts-node/register node_modules/typeorm/cli.js migration:revert -d src/services/notification-service/src/database/data-source.ts",
    "mq:up": "docker compose --env-file .env -f deploy/rabbitmq-dev.compose.yml up -d --wait",
    "mq:stop": "docker compose --env-file .env -f deploy/rabbitmq-dev.compose.yml stop",
    "mq:start": "docker compose --env-file .env -f deploy/rabbitmq-dev.compose.yml start",
    "mq:status": "docker compose --env-file .env -f deploy/rabbitmq-dev.compose.yml ps",
    "events:schema": "node -r ts-node/register -r tsconfig-paths/register scripts/messaging/schema.cjs",
    "events:topology": "node -r ts-node/register -r tsconfig-paths/register scripts/messaging/topology.cjs",
    "events:send": "node -r ts-node/register -r tsconfig-paths/register scripts/messaging/send-sample.cjs",
    "events:dlq": "node -r ts-node/register -r tsconfig-paths/register scripts/messaging/dlq.cjs",
    "stack:up": "docker compose --env-file .env -f deploy/docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose --env-file .env -f deploy/docker-compose.yml down",
    "stack:ps": "docker compose --env-file .env -f deploy/docker-compose.yml ps",
    "stack:logs": "docker compose --env-file .env -f deploy/docker-compose.yml logs -f --tail 100",
    "test:c:recovery": "npm run build:simulated-payment-service && npm run build:notification-service && node --test --test-timeout=600000 -r ts-node/register -r tsconfig-paths/register tests/fault-tolerance/c-recovery.test.cjs",
    "test:c:security": "npm run build:simulated-payment-service && npm run build:notification-service && npm run build:api-gateway && node --test --test-timeout=600000 -r ts-node/register -r tsconfig-paths/register tests/security/c-security.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "2.2.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "17.4.2",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.2.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/amqplib": "0.10.8",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "concurrently": "^9.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "ts-loader": "^9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2"
