{
  "name": "ds03-ride-hailing",
  "version": "0.1.0",
  "private": true,
  "description": "Ride-hailing microservices system simulating Grab/Uber",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:api-gateway",
    "start": "npm run start:api-gateway",
    "start:dev": "npm run dev:api-gateway",
    "start:prod": "npm run prod:api-gateway",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:all && npm run build:identity-migrations && node --test tests/startup.test.cjs tests/identity.integration.test.cjs tests/swagger.test.cjs",
    "test:swagger": "npm run test:identity:docs && npm run build:all && node --test tests/swagger.test.cjs",
    "test:identity:docs": "node --test -r ts-node/register -r tsconfig-paths/register src/services/identity-user-service/tests/unit/swagger.test.cjs",
    "test:smoke": "node --test tests/startup.test.cjs",
    "build:all": "node scripts/build-all.cjs",
    "openapi:dump": "node scripts/dev/dump-openapi.cjs",
    "openapi:compare": "node scripts/dev/compare-openapi.cjs",
    "start:all": "concurrently --kill-others --names api-gateway,identity-user-service,driver-vehicle-location-service,trip-booking-service,simulated-payment-service,notification-service,matching-service,pricing-service \"npm:start:api-gateway\" \"npm:start:identity-user-service\" \"npm:start:driver-vehicle-location-service\" \"npm:start:trip-booking-service\" \"npm:start:simulated-payment-service\" \"npm:start:notification-service\" \"npm:start:matching-service\" \"npm:start:pricing-service\"",
    "start:dev:all": "concurrently --kill-others --names api-gateway,identity-user-service,driver-vehicle-location-service,trip-booking-service,simulated-payment-service,notification-service,matching-service,pricing-service \"npm:dev:api-gateway\" \"npm:dev:identity-user-service\" \"npm:dev:driver-vehicle-location-service\" \"npm:dev:trip-booking-service\" \"npm:dev:simulated-payment-service\" \"npm:dev:notification-service\" \"npm:dev:matching-service\" \"npm:dev:pricing-service\"",
    "start:prod:all": "concurrently --kill-others --names api-gateway,identity-user-service,driver-vehicle-location-service,trip-booking-service,simulated-payment-service,notification-service,matching-service,pricing-service \"npm:prod:api-gateway\" \"npm:prod:identity-user-service\" \"npm:prod:driver-vehicle-location-service\" \"npm:prod:trip-booking-service\" \"npm:prod:simulated-payment-service\" \"npm:prod:notification-service\" \"npm:prod:matching-service\" \"npm:prod:pricing-service\"",
    "build:api-gateway": "nest build api-gateway",
    "start:api-gateway": "nest start api-gateway",
    "dev:api-gateway": "nest start api-gateway --watch",
    "prod:api-gateway": "node dist/api-gateway/main.js",
    "build:identity-user-service": "nest build identity-user-service",
    "start:identity-user-service": "nest start identity-user-service",
    "dev:identity-user-service": "nest start identity-user-service --watch",
    "prod:identity-user-service": "node dist/identity-user-service/main.js",
    "build:driver-vehicle-location-service": "nest build driver-vehicle-location-service",
    "start:driver-vehicle-location-service": "nest start driver-vehicle-location-service",
    "dev:driver-vehicle-location-service": "nest start driver-vehicle-location-service --watch",
    "prod:driver-vehicle-location-service": "node dist/driver-vehicle-location-service/main.js",
    "build:trip-booking-service": "nest build trip-booking-service",
    "start:trip-booking-service": "nest start trip-booking-service",
    "dev:trip-booking-service": "nest start trip-booking-service --watch",
    "prod:trip-booking-service": "node dist/trip-booking-service/main.js",
    "build:simulated-payment-service": "nest build simulated-payment-service",
    "start:simulated-payment-service": "nest start simulated-payment-service",
    "dev:simulated-payment-service": "nest start simulated-payment-service --watch",
    "prod:simulated-payment-service": "node dist/simulated-payment-service/main.js",
    "build:notification-service": "nest build notification-service",
    "start:notification-service": "nest start notification-service",
    "dev:notification-service": "nest start notification-service --watch",
    "prod:notification-service": "node dist/notification-service/main.js",
    "build:matching-service": "nest build matching-service",
    "start:matching-service": "nest start matching-service",
    "dev:matching-service": "nest start matching-service --watch",
    "prod:matching-service": "node dist/matching-service/main.js",
    "build:pricing-service": "nest build pricing-service",
    "start:pricing-service": "nest start pricing-service",
    "dev:pricing-service": "nest start pricing-service --watch",
    "prod:pricing-service": "node dist/pricing-service/main.js",
    "identity:setup:dev": "node scripts/identity/setup-dev.cjs",
    "auth:keys:generate": "node scripts/identity/generate-keys.cjs",
    "identity:db:up": "node scripts/identity/dev-db.cjs up",
    "identity:db:stop": "node scripts/identity/dev-db.cjs stop",
    "identity:db:start": "node scripts/identity/dev-db.cjs start",
    "migration:identity:run": "node scripts/identity/migrate.cjs run",
    "migration:identity:show": "node scripts/identity/migrate.cjs show",
    "migration:identity:revert": "node scripts/identity/migrate.cjs revert",
    "build:identity-migrations": "tsc -p src/services/identity-user-service/tsconfig.migrations.json",
    "test:identity:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/services/identity-user-service/tests/unit/auth.test.cjs",
    "test:identity:integration": "npm run build:all && npm run build:identity-migrations && node --test tests/identity.integration.test.cjs",
    "test:identity:security": "npm run test:identity:integration",
    "demo:identity": "node scripts/identity/demo.cjs",
    "identity:dev": "concurrently --kill-others --names gateway,identity,driver \"npm:dev:api-gateway\" \"npm:dev:identity-user-service\" \"npm:dev:driver-vehicle-location-service\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "17.4.2",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.2.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "concurrently": "^9.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "ts-loader": "^9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2"
  }
}
