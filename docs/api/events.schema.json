{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds03.local/events.schema.json",
  "title": "DS03 ride events",
  "description": "Exchange topic ride.events; routing key = type; schema_version = 1. Sinh từ src/packages/contracts/src/events/schema.ts, không sửa tay.",
  "oneOf": [
    {
      "$ref": "#/$defs/trip.requested"
    },
    {
      "$ref": "#/$defs/matching.offer.created"
    },
    {
      "$ref": "#/$defs/matching.failed"
    },
    {
      "$ref": "#/$defs/trip.no_driver"
    },
    {
      "$ref": "#/$defs/trip.accepted"
    },
    {
      "$ref": "#/$defs/trip.started"
    },
    {
      "$ref": "#/$defs/trip.completed"
    },
    {
      "$ref": "#/$defs/trip.cancelled"
    },
    {
      "$ref": "#/$defs/payment.requested"
    },
    {
      "$ref": "#/$defs/payment.succeeded"
    },
    {
      "$ref": "#/$defs/payment.failed"
    }
  ],
  "$defs": {
    "trip.requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "type",
        "schema_version",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "causation_id",
        "producer",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "trip.requested"
        },
        "schema_version": {
          "const": 1
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": "string",
          "format": "uuid"
        },
        "producer": {
          "const": "trip-booking-service"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tripId",
            "passengerId",
            "pickup",
            "dropoff",
            "amount",
            "currency",
            "tripVersion"
          ],
          "properties": {
            "tripId": {
              "type": "string",
              "format": "uuid"
            },
            "passengerId": {
              "type": "string",
              "format": "uuid"
            },
            "pickup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lat",
                "lng",
                "zoneId"
              ],
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "zoneId": {
                  "enum": [
                    "ZONE_A",
                    "ZONE_B"
                  ]
                }
              }
            },
            "dropoff": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lat",
                "lng",
                "zoneId"
              ],
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "zoneId": {
                  "enum": [
                    "ZONE_A",
                    "ZONE_B"
                  ]
                }
              }
            },
            "amount": {
              "type": "string",
              "pattern": "^[0-9]{1,14}$"
            },
            "currency": {
              "const": "VND"
            },
            "tripVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "title": "EVT-01 trip.requested",
      "description": "Tạo job idempotent theo tripId; không mở lại tombstone đã hủy.",
      "x-producer": "trip-booking-service",
      "x-queues": [
        "matching.events"
      ]
    },
