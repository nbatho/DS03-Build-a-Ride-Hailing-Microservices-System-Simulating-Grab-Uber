  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      },
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "Point": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lat",
          "lng",
          "zoneId"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "zoneId": {
            "type": "string",
            "enum": [
              "ZONE_A",
              "ZONE_B"
            ]
          }
        }
      },
      "Trip": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passengerId",
          "quoteId",
          "pickup",
          "dropoff",
          "amount",
          "currency",
          "status",
          "paymentStatus",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "passengerId": {
            "type": "string",
            "format": "uuid"
          },
          "driverId": {
            "type": "string",
            "format": "uuid",
            "description": "Chỉ có từ khi chuyến được gán tài xế."
          },
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "assignmentId": {
            "type": "string",
            "format": "uuid",
            "description": "Chỉ có từ khi bắt đầu nhận chuyến."
          },
          "pickup": {
            "$ref": "#/components/schemas/Point"
          },
          "dropoff": {
            "$ref": "#/components/schemas/Point"
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d{1,14}$",
            "description": "Số nguyên VND dạng chuỗi."
          },
          "currency": {
            "type": "string",
            "enum": [
              "VND"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "MATCHING",
              "ASSIGNING",
              "ASSIGNED",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLING",
              "CANCELLED",
              "NO_DRIVER"
            ]
          },
          "paymentStatus": {
            "type": "string",
            "enum": [
              "NOT_REQUESTED",
              "PENDING",
              "PENDING_RETRY",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "paymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Chỉ có từ khi chuyến COMPLETED."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TripsPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trip"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tripId",
          "type",
          "status",
          "tripStatus",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tripId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT",
              "CANCEL",
              "COMPLETE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "SUCCEEDED",
              "FAILED_COMPENSATED",
              "FAILED_NEEDS_REVIEW"
            ]
          },
          "tripStatus": {
            "type": "string",
            "enum": [
              "MATCHING",
              "ASSIGNING",
              "ASSIGNED",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLING",
              "CANCELLED",
              "NO_DRIVER"
            ]
          },
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "errorCode": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateTripRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quoteId"
        ],
        "properties": {
          "quoteId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AcceptRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offerId"
        ],
        "properties": {
          "offerId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RejectRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offerId",
          "reason"
        ],
        "properties": {
          "offerId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "UNAVAILABLE",
              "NOT_INTERESTED"
            ]
          }
        }
      },
      "CancelRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "CHANGE_PLAN",
              "WAIT_TOO_LONG"
            ]
          }
        }
      },
      "EmptyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "RetryOperationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commandId",
          "reason"
        ],
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
