        "description": "Trip đọc quote từ Pricing, kiểm tra chủ sở hữu và hạn, chốt giá vào chuyến và phát trip.requested. Lỗi 409: QUOTE_EXPIRED, QUOTE_ALREADY_USED, IDEMPOTENCY_CONFLICT.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Cùng key và cùng body trả kết quả đã lưu; cùng key khác body trả 409 IDEMPOTENCY_CONFLICT."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
